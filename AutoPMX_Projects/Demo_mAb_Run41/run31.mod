0.04 ; IIV CL
0.04 ; IIV V1
0.04 ; IIV Q
0.04 ; IIV V2
$PROBLEM
;; Demo starting model for AutoPMX AI automation

$INPUT C ID CYCLE DAY TIME NTIME DV AMT RATE DUR CMT DOSE MDV EVID BQL TYPE STUDY SEX WT AGE
$DATA NM_dat_new.csv IGNORE=C
$SUBROUTINES ADVAN3 TRANS4

$PK
D1 = MAX(DUR, 0.0001)
CL = THETA(1) * EXP(ETA(1))
V1 = THETA(2) * EXP(ETA(2))
Q  = THETA(3) * EXP(ETA(3))
V2 = THETA(4) * EXP(ETA(4))
S1 = V1/1000

$ERROR
IPRED = F
W = SQRT(THETA(5)**2*IPRED**2 + THETA(6)**2)
Y = IPRED + W*EPS(1)

$THETA
(0, 0.0122)
(0, 4.36)
(0, 0.0207)
(0, 2)
(0, 0.141)
(0) FIX

$OMEGA
$SIGMA
1 FIX

$EST METHOD=1 INTER MAXEVAL=9999 NOABORT SIG=3 PRINT=10
$COV
$TABLE ID TIME DV MDV PRED IPRED CWRES CIWRES CYCLE DAY NTIME AMT RATE DUR CMT DOSE EVID BQL TYPE SEX WT AGE ONEHEADER NOPRINT NOAPPEND FILE=sdtab31 FORMAT=s1PE14.7
$TABLE ID CL V ETA1 ETA2 ETA3 ETA4 NOPRINT NOAPPEND ONEHEADER FILE=patab31
$TABLE ID ETA1 ETA2 ETA3 ETA4 FIRSTONLY NOAPPEND NOPRINT FILE=run31.ETA
$TABLE ID SEX STUDY BQL TYPE CMT EVID MDV FIRSTONLY NOPRINT NOAPPEND ONEHEADER FILE=catab31
$TABLE ID WT AGE DOSE AMT RATE DUR FIRSTONLY NOPRINT NOAPPEND ONEHEADER FILE=cotab31