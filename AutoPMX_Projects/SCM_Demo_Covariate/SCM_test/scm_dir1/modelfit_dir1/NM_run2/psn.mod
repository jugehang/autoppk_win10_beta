;; 1. Based on: run31
;; 2. Description: PM Model V3 V2 FIX
;; x1. Author: DUXACT
$PROBLEM   
$INPUT      C ID TIME EVID CMT AMT DV MDV II ADDL SEX AGE=DROP WT=DROP
            TYPE
$DATA      ../../NM_dat.csv IGNORE=C
$SUBROUTINE ADVAN13 TOL=5
$MODEL      COMP(DEPOT,DEFDOS) COMP(CENTPRNT,DEFOBS) COMP(METABOLITE)
$PK
;;; CLSEX-DEFINITION START
IF(SEX.EQ.0) CLSEX = 1  ; Most common
IF(SEX.EQ.1) CLSEX = ( 1 + THETA(11))
;;; CLSEX-DEFINITION END

;;; CL-RELATION START
CLCOV=CLSEX
;;; CL-RELATION END



    TVCL = THETA(1)

TVCL = CLCOV*TVCL
     CL = TVCL * EXP(ETA(1))

    TVV2 = THETA(2)
     V2 = TVV2 

    TVKA = THETA(3)
     KA = TVKA
   
	KPM = CL/V2

	TVCLM = THETA(4)
	 CLM = TVCLM * EXP(ETA(2))
	 
	TVV3  = THETA(5)
	 V3 = TVV3
	 
	TVFM = THETA(6)
	FM = TVFM
	 
	 
$DES
  DADT(1) = -KA*A(1)
  DADT(2) =  KA*A(1) - CL/V2*A(2)
  DADT(3) =  FM*KPM*A(2)- CLM/V3*A(3)

$ERROR
$ERROR

    CP = A(2)/V2*1000 

    CM = A(3)/V3*1000 

  IF (TYPE.EQ.2) IPRED = CP
  IF (TYPE.EQ.3) IPRED = CM
  
  IF (TYPE.EQ.2) W = SQRT(THETA(7)**2 * IPRED**2 + THETA(8)**2)
  IF (TYPE.EQ.3) W = SQRT(THETA(9)**2 * IPRED**2 + THETA(10)**2)
  
  Y = IPRED + W*EPS(1)
  IRES = DV-IPRED
  IWRES = IRES/W


$THETA  (0,3.42)
 (0,31.1)
 (0,0.3) FIX
 (0,3.75)
 (0,2.23)
 (0,1) FIX
 (0,0.348)
 (0,14.6)
 (0,0.311)
 (0,21)
$THETA  (-1,-0.001,5) ; CLSEX1
$OMEGA  0.2
 0.1
$SIGMA  1  FIX
 1  FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=99999 SLOW NOABORT PRINT=10 SIG=3

