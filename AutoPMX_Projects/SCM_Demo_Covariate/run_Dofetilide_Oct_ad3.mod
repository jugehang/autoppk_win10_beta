;; 1. Based on: run_Dofetilide_Oct_ad2
;; 2. Description: linear mixed effect model_Verapamil
;; 3. Label:
;; x1. Author: LX

$PROBLEM LME

$INPUT C ID TIME CONC DV TRT TIME1 TIME2 TIME3 TIME4 TIME5 TIME6 TIME7 TIME8 TIME9 TIME10 TIME11 TIME12 TIME13 TIME14 TIME15 BASE

$DATA Dofetilide_QTC_Oct.csv  IGNORE=C

$PRED
TVINT = THETA(1)       
INT = TVINT + ETA(1)

TVTRT = THETA(2)  
     
TVSLOPE = THETA(3)     
SLOPE =TVSLOPE +ETA(2)

TVTIME1 = THETA(4)   
TVTIME2 = THETA(5) 
TVTIME3 = THETA(6) 
TVTIME4 = THETA(7) 
TVTIME5 = THETA(8) 
TVTIME6 = THETA(9) 
TVTIME7 = THETA(10) 
TVTIME8 = THETA(11) 
TVTIME9 = THETA(12) 
TVTIME10 = THETA(13) 
TVTIME11 = THETA(14) 
TVTIME12 = THETA(15) 
TVTIME13 = THETA(16) 
TVTIME14 = THETA(17) 
TVTIME15 = THETA(18) 

TVBASE = THETA(19)     
 
; define the model
IPRED = INT + TVTRT * TRT + SLOPE * CONC + TIME1*TVTIME1+TIME2*TVTIME2+TIME3*TVTIME3+TIME4*TVTIME4+TIME5*TVTIME5+TIME6*TVTIME6+TIME7*TVTIME7+TIME8*TVTIME8+TIME9*TVTIME9+TIME10*TVTIME10+TIME11*TVTIME11+TIME12*TVTIME12+TIME13*TVTIME13+TIME14*TVTIME14+TIME15*TVTIME15+ TVBASE * BASE

DVADJUST =  INT + TVTRT * TRT + SLOPE * CONC +TVBASE * BASE


W = SQRT(THETA(20)**2)
Y = IPRED + W * EPS(1)
IRES = DV - IPRED
IWRES = IRES / W

$THETA
(0.581) ;Intercept
(-1.16) ;treatment
(0.0266) ;slope
(-13.5) ;time_0.5
(-13.3) ;time_1
(-7.43) ;time_1.5
(-2.92) ;time_2
(0.577) ;time_2.5
(-3.08) ;time_3
(-7.77) ;time_3.5
(-6.79) ;time_4
(-7.5) ;time_5
(-8.12) ;time_6
(-8.63) ;time_7
(-9.5) ;time_8
(-13.3) ;time_12
(-13.1) ;time_14
(-5.78) ;time_24
(-0.271) ;baseline
(0, 9.11) ;add.effect

$OMEGA
 28.4 ; ETA(1) 
 3.63E-05 ; ETA(2) 

$SIGMA
 1 FIX  ; Residual error

$EST METHOD=1 INTER MAXEVAL=9999 NOABORT SIG=3 PRINT=10
$COV

; Xpose
$TABLE ID TIME CONC DV DVADJUST TRT TVINT TVSLOPE TVTRT TVBASE IPRED PRED IWRES CWRES CIWRES ETA(1) ETA(2) NOHEADER NOPRINT NOAPPEND FILE=sdtab1_Dofetilide_Oct_1
